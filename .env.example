# ---------------------------------------------------------------------------
# Central database (Supabase PostgreSQL, or any PostgreSQL 14+)
# ---------------------------------------------------------------------------
# One database for the whole platform. Every office is a row, not a schema.
# Use the pooled connection string for the app and the direct one for migrations.
DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Public HTTPS origin - used for the Meta webhook and the Haraj share links.
PUBLIC_URL=https://your-app.up.railway.app

JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=12h

# Created automatically on first boot. Change the password immediately after.
SUPER_ADMIN_EMAIL=admin@your-domain.com
SUPER_ADMIN_PASSWORD=set-a-strong-password

# Three free months, then a 7-day grace period before writes are frozen.
TRIAL_DAYS=90
GRACE_DAYS=7

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Meta) - the office owner's entire interface
# ---------------------------------------------------------------------------
# Any string; you type the same value into Meta's webhook setup screen.
WHATSAPP_VERIFY_TOKEN=pick-any-string
# Meta App Secret. Required in production: it authenticates every webhook.
WHATSAPP_APP_SECRET=
# Permanent System User token with whatsapp_business_messaging.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
# Fallback sender; each office normally has its own phone_number_id.
WHATSAPP_PHONE_NUMBER_ID=

# ---------------------------------------------------------------------------
# Media storage (Supabase Storage)
# ---------------------------------------------------------------------------
# WhatsApp media ids expire, so photos and videos are mirrored here.
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=property-media

# ---------------------------------------------------------------------------
# TikTok (official Content Posting API)
# ---------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-app.up.railway.app/api/integrations/tiktok/callback
TIKTOK_API_BASE_URL=https://open.tiktokapis.com

# Set to "query" to log every SQL statement.
PRISMA_LOG=

# Set to "false" to serve HTTP without running the scheduled workers
# (broadcast dispatch, draft finalisation, subscription sweep). Exactly one
# instance should run them.
WORKERS_ENABLED=true
